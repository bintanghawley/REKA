// =============================================================================
// PRISMA SCHEMA — REKA UMKM Daily Transaction Logging
// Database: SQLite via Prisma ORM
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// MODEL: User
// Menyimpan kredensial autentikasi (email + hashed password).
// -----------------------------------------------------------------------------
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password_hash String

  created_at DateTime @default(now())

  // Relasi ke semua tabel yang menggunakan user_id
  profile     Profile?
  produk      Produk[]
  transaksi   Transaksi[]
  pengeluaran PengeluaranDadakan[]

  @@map("users")
}

// -----------------------------------------------------------------------------
// MODEL: Profile
// Data profil usaha UMKM — 1-to-1 dengan User.
// id = FK ke users.id (bukan auto-generated).
// -----------------------------------------------------------------------------
model Profile {
  id          String   @id
  nama_usaha  String   @default("")
  jenis_usaha String   @default("")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// -----------------------------------------------------------------------------
// MODEL: Produk
// Master data produk UMKM.
// -----------------------------------------------------------------------------
model Produk {
  id         String   @id @default(uuid())
  user_id    String

  nama       String
  harga_jual Float
  hpp        Float
  kategori   String   @default("Makanan")
  status     String   @default("Tersedia")
  foto       String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user      User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transaksi Transaksi[]

  @@index([user_id])
  @@map("produk")
}

// -----------------------------------------------------------------------------
// MODEL: Transaksi
// Catatan transaksi harian.
//
// Kolom harga_jual_saat_transaksi & hpp_saat_transaksi menyimpan SNAPSHOT HARGA
// pada saat transaksi terjadi. Ini menjamin integritas data historis untuk
// perhitungan Omzet, Laba Kotor, dan Laba Bersih meskipun harga produk
// diubah di kemudian hari.
// -----------------------------------------------------------------------------
model Transaksi {
  id        String   @id @default(uuid())
  user_id   String
  produk_id String

  qty                       Int
  harga_jual_saat_transaksi Float
  hpp_saat_transaksi        Float

  waktu      DateTime
  created_at DateTime @default(now())

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  produk Produk @relation(fields: [produk_id], references: [id], onDelete: Restrict)

  @@index([user_id])
  @@index([produk_id])
  @@index([waktu])
  @@index([user_id, waktu])
  @@map("transaksi")
}

// -----------------------------------------------------------------------------
// MODEL: PengeluaranDadakan
// Catatan pengeluaran tak terduga / operasional UMKM.
// -----------------------------------------------------------------------------
model PengeluaranDadakan {
  id      String   @id @default(uuid())
  user_id String

  kategori String
  nominal  Float
  tanggal  DateTime

  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([tanggal])
  @@index([user_id, tanggal])
  @@map("pengeluaran_dadakan")
}
