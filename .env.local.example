# =============================================================================
# Environment Variables — REKA UMKM (Supabase PostgreSQL + Auth.js v5)
# =============================================================================
# Salin file ini ke .env.local untuk development lokal:
#   copy .env.local.example .env.local
# Dan pasang nilai yang sama di dashboard Vercel -> Settings -> Environment Variables.
# JANGAN commit .env.local ke Git repository.

# -----------------------------------------------------------------------------
# 1. DATABASE (Supabase PostgreSQL via Prisma)
# -----------------------------------------------------------------------------
# Dapatkan kedua URL ini dari Dashboard Supabase:
# Masuk ke Project Settings -> Database -> Connection string:
#
# A. DATABASE_URL: Gunakan Mode "Transaction" (Port 6543) dengan pooler pgbouncer
#    Digunakan oleh runtime aplikasi & serverless function di Vercel:
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# B. DIRECT_URL: Gunakan Mode "Session" / Direct (Port 5432)
#    Wajib untuk Prisma CLI saat migrasi (db:push, migrate):
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# 2. AUTH.JS v5 (NextAuth)
# -----------------------------------------------------------------------------
# Secret untuk menandatangani JWT token session. Minimal 32 karakter acak.
# Generate acak di terminal PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
AUTH_SECRET="ganti_dengan_random_secret_minimal_32_karakter_bebas"

# Wajib 'true' saat deploy di Vercel agar Auth.js mempercayai proxy reverse-host Vercel:
AUTH_TRUST_HOST=true

# URL aplikasi (opsional di Vercel, otomatis terdeteksi):
# Development: http://localhost:3000
# Production:  https://nama-proyek-anda.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# 3. GOOGLE GEMINI AI (Chatbot REKA Assistant)
# -----------------------------------------------------------------------------
# Dapatkan API key gratis dari Google AI Studio:
# https://aistudio.google.com/apikey
# Model: Gemini 2.0 Flash (gratis, 15 RPM / 1M TPM)
GEMINI_API_KEY="ganti_dengan_api_key_dari_aistudio_google_com"

