// =============================================================================
// Environment Variables — REKA UMKM (Self-Hosted PostgreSQL + Auth.js)
// ItechnoCup 2026 (SDG 8)
// =============================================================================
# Salin file ini ke .env.local dan isi dengan nilai sesuai konfigurasi Anda.
# JANGAN commit .env.local ke Git (sudah ada di .gitignore).

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL — Self-Hosted via Docker atau VPS)
# -----------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Untuk development lokal dengan docker-compose.yml:
DATABASE_URL="postgresql://reka_user:changeme@localhost:5432/reka_db"

# -----------------------------------------------------------------------------
# AUTH.JS v5 (NextAuth)
# -----------------------------------------------------------------------------
# Secret untuk menandatangani JWT token. WAJIB diisi di production.
# Generate dengan: openssl rand -base64 32
AUTH_SECRET="GANTI_DENGAN_SECRET_MINIMAL_32_KARAKTER_ACAK"

# URL aplikasi Anda (tanpa trailing slash).
# Development: http://localhost:3000
# Production:  https://yourdomain.com
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# DATABASE DOCKER (opsional — untuk docker-compose.yml)
# Hanya diperlukan jika menjalankan PostgreSQL via Docker Compose.
# -----------------------------------------------------------------------------
POSTGRES_DB="reka_db"
POSTGRES_USER="reka_user"
POSTGRES_PASSWORD="changeme"
